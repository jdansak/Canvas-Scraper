# Canvas LMS Configuration for Mount Paran Christian School
CANVAS_URL=https://mtparanschool.instructure.com

# Your login credentials:
CANVAS_USER_ID=
CANVAS_PASSWORD=

# Optional: If your account has access to create an API token:
# Go to https://mtparanschool.instructure.com/profile/settings -> + New Access Token
# CANVAS_API_TOKEN=

# Load & Rate-Limiting Options:
# Skip non-graded / homeroom / counseling courses (true or false)
SKIP_NONGRADED=true

# Exclude "Not Graded" / 0% weight categories and assignments that do not affect the grade (true or false)
SKIP_UNGRADED_ITEMS=true

# Cache duration for scraped data before hitting Canvas again (e.g. 30s, 10m, 1h, or 0 to disable)
CACHE_TIMER=10m

# Directory where exported JSON, CSV, HTML, Markdown, and cache files are saved (supports ~/... paths)
OUTPUT_DIR=output

# Optional Assignment Filters (can also be passed via CLI flags — run with --help for details):
# HIDE_FUTURE_DUE=false
# FUTURE_ONLY=false
# DUE_WITHIN=
# DUE_PAST=
# HIDE_NO_DUE_DATE=false
# MISSING_AFTER_DAYS=
# STATUS_FILTER=
# SCORE_BELOW=
# MIN_CATEGORY_WEIGHT=
# SORT_BY=date-desc
